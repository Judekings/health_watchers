{
  "title": "API Service Scaling",
  "uid": "api-service-scaling",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API Replica Count",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "kube_deployment_status_replicas{deployment=\"api\"}", "legendFormat": "Replicas" }],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 8 }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API Requests/min",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "rate(http_requests_total{job=\"health-watchers-api\"}[1m]) * 60", "legendFormat": "req/min" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API Replica Count Over Time",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "kube_deployment_status_replicas{deployment=\"api\"}", "legendFormat": "Replicas" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API CPU Utilization",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{container=\"api\"}[5m]) * 100",
          "legendFormat": "CPU % {{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API Memory Usage",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{container=\"api\"}",
          "legendFormat": "Memory {{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request Rate by Status",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"health-watchers-api\"}[5m])",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
